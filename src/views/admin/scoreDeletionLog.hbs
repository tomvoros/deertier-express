<html>
  <head>
    <title>Score Deletion Log</title>

    <!-- DataTables CSS -->
    <link rel="stylesheet" type="text/css" href="//cdn.datatables.net/1.10.2/css/jquery.dataTables.css">
  
    <!-- jQuery -->
    <script type="text/javascript" charset="utf8" src="//code.jquery.com/jquery-1.10.2.min.js"></script>
  
    <!-- DataTables -->
    <script type="text/javascript" charset="utf8" src="//cdn.datatables.net/1.10.2/js/jquery.dataTables.js"></script>

    <script type="text/javascript" src="/javascripts/main.js"></script>
  </head>

  <body>
    <h2>Score Deletion Log</h2>

    <table id="scoreDeletionLog">
      <thead>
        <tr>
          <th>ID</th>
          <th>Moderator</th>
          <th>DeletionDate</th>
          <th>IP</th>
          <th>CategoryId</th>
          <th>Player</th>
          <th>RealTimeString</th>
          <th>RealTimeSeconds</th>
          <th>GameTimeString</th>
          <th>GameTimeSeconds</th>
          <th>Comment</th>
          <th>VideoURL</th>
          <th>CeresTime</th>
          <th>DateSubmitted</th>
        </tr>
      </thead>
      <tbody>
        {{#each Records}}
          <tr>
            <td>{{ID}}</td>
            <td>{{Moderator}}</td>
            <td>{{DeletionDate}}</td>
            <td>{{IPAddress}}</td>
            <td>{{CategoryId}}</td>
            <td>{{Player}}</td>
            <td>{{RealTimeString}}</td>
            <td>{{RealTimeSeconds}}</td>
            <td>{{GameTimeString}}</td>
            <td>{{GameTimeSeconds}}</td>
            <td>{{Comment}}</td>
            <td>{{VideoURL}}</td>
            <td>{{CeresTime}}</td>
            <td>{{DateSubmitted}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </body>
</html>
