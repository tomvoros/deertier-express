<div id="login">
  <h1>Change Password</h1>
  <br />

  <form method="post">
    <div class="loginSignUpForm">
      Current password:
      <input type="password" name="currentPassword" />
      <br />
      New password:
      <input type="password" name="newPassword" />
      <br />
      Confirm new password:
      <input type="password" name="confirmedNewPassword" />
      <br />
    </div>

    <input class="genericButton" type="submit" value="Submit" />   
  </form>

  <div class="statusLiteral">
    {{{Message}}}
  </div>
  <br />
</div>